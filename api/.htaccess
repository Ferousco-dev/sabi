# Protect sensitive files
<FilesMatch "config\.php|db\.php|auth_middleware\.php">
    Order deny,allow
    Deny from all
</FilesMatch>

# Allow CORS Preflight
RewriteEngine On
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Redirect all to index.php if we used a router,
# but here we use direct file access.
